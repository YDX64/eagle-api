{
  "info": {
    "name": "Golsinyali Football API",
    "description": "High-performance football match data API. Multi-source failover, intelligent caching, comprehensive analysis.\n\n## Base URLs\n- Production: https://api.golsinyali.com/api/v1\n- Development: http://localhost:8000/api/v1\n\n## Authentication\nUse the 'Generate JWT Token' request first, then copy the `access_token` into the `jwt_token` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string",
      "description": "API base URL. Change to https://api.golsinyali.com/api/v1 for production."
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token. Obtain via POST /auth/token."
    },
    {
      "key": "api_key",
      "value": "your-api-secret-key",
      "type": "string",
      "description": "API secret key. Set this to your actual API_SECRET_KEY."
    },
    {
      "key": "match_id",
      "value": "2804405",
      "type": "string",
      "description": "Example match ID. Change as needed."
    },
    {
      "key": "league_id",
      "value": "36",
      "type": "string",
      "description": "Example league ID (36 = Turkey Super Lig)."
    },
    {
      "key": "season",
      "value": "2024-2025",
      "type": "string",
      "description": "Season string. Format: YYYY-YYYY"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Generate JWT tokens for API access.",
      "item": [
        {
          "name": "Generate JWT Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"api_key\": \"{{api_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/token",
              "host": ["{{base_url}}"],
              "path": ["auth", "token"]
            },
            "description": "Exchange an API key for a JWT Bearer token (expires in 1 hour).\n\nAfter running this request, copy the `access_token` from the response and set the `jwt_token` collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', response.access_token);",
                  "    console.log('JWT token saved to collection variable: jwt_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Matches",
      "description": "Match data endpoints — details, H2H, odds, and date-based lists.",
      "item": [
        {
          "name": "Get Match Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/match/{{match_id}}",
              "host": ["{{base_url}}"],
              "path": ["match", "{{match_id}}"],
              "query": [
                {
                  "key": "fields",
                  "value": "",
                  "description": "Optional: comma-separated fields to return (e.g. match_id,home_team,away_team)",
                  "disabled": true
                }
              ]
            },
            "description": "Get comprehensive match details including analysis (H2H summary, form, predictions).\n\nCache TTL: 60s (live), 5min (scheduled), 24h (finished)"
          },
          "response": []
        },
        {
          "name": "Get Match H2H",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/match/{{match_id}}/h2h",
              "host": ["{{base_url}}"],
              "path": ["match", "{{match_id}}", "h2h"]
            },
            "description": "Detailed Head-to-Head data:\n- H2H match history (last 10)\n- Home team last 5 matches\n- Away team last 5 matches\n- Standings, injuries, lineups\n\nCache TTL: 24 hours"
          },
          "response": []
        },
        {
          "name": "Get Match Odds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/match/{{match_id}}/odds",
              "host": ["{{base_url}}"],
              "path": ["match", "{{match_id}}", "odds"]
            },
            "description": "Detailed odds data:\n- Corner odds\n- Correct score odds\n- Double chance odds\n- First half odds\n- Odds comparison (multiple bookmakers)\n\nCache TTL: 15 minutes"
          },
          "response": []
        },
        {
          "name": "Get Matches by Date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/matches/date/2026-02-19?sort_by_time=true",
              "host": ["{{base_url}}"],
              "path": ["matches", "date", "2026-02-19"],
              "query": [
                {
                  "key": "sort_by_time",
                  "value": "true",
                  "description": "Sort matches by match time (default: true)"
                }
              ]
            },
            "description": "All matches for a specific date. Format: YYYY-MM-DD\n\nCache TTL: 5min (today/future), 24h (past)"
          },
          "response": []
        },
        {
          "name": "Get Today's Matches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/matches/today?sort_by_time=true",
              "host": ["{{base_url}}"],
              "path": ["matches", "today"],
              "query": [
                {
                  "key": "sort_by_time",
                  "value": "true"
                }
              ]
            },
            "description": "Shortcut for today's matches. Cache TTL: 5 minutes."
          },
          "response": []
        },
        {
          "name": "Get Tomorrow's Matches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/matches/tomorrow",
              "host": ["{{base_url}}"],
              "path": ["matches", "tomorrow"]
            },
            "description": "Shortcut for tomorrow's matches. Cache TTL: 5 minutes."
          },
          "response": []
        },
        {
          "name": "Get Yesterday's Matches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/matches/yesterday",
              "host": ["{{base_url}}"],
              "path": ["matches", "yesterday"]
            },
            "description": "Shortcut for yesterday's matches. Cache TTL: 24 hours (historical)."
          },
          "response": []
        }
      ]
    },
