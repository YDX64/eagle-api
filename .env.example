# ============================================================================
# FLASK API - ENVIRONMENT VARIABLES
# ============================================================================
# Bu dosya .env.example'dır - GİTHUB'a yüklenebilir (örnek değerler içerir)
# Gerçek değerlerinizi .env dosyasına yazın (.env asla GitHub'a yüklenmez)
#
# KURULUM:
# 1. Bu dosyayı kopyalayın: cp .env.example .env
# 2. .env dosyasındaki değerleri gerçek değerlerle değiştirin
# 3. .env dosyası .gitignore'da olduğu için Git'e yüklenmeyecektir
# ============================================================================

# ----------------------------------------------------------------------------
# FLASK CONFIGURATION
# ----------------------------------------------------------------------------
FLASK_ENV=development
# Seçenekler: development, production, testing

# ----------------------------------------------------------------------------
# SECURITY - KRİTİK! Aşağıdaki değerler ZORUNLUDUR!
# ----------------------------------------------------------------------------
# ÖNEMLİ: Bu değerler güçlü, rastgele ve benzersiz olmalıdır!
# Üretmek için: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Flask session şifreleme anahtarı (ZORUNLU)
SECRET_KEY=BURAYA_GUCLU_RASTGELE_ANAHTAR_YAZIN

# API authentication anahtarı (ZORUNLU)
API_SECRET_KEY=BURAYA_GUCLU_RASTGELE_API_KEY_YAZIN

# JWT token şifreleme anahtarı (ZORUNLU)
JWT_SECRET_KEY=BURAYA_GUCLU_RASTGELE_JWT_KEY_YAZIN

# JWT token süresi (saniye cinsinden)
JWT_ACCESS_TOKEN_EXPIRES=3600

# ----------------------------------------------------------------------------
# CORS CONFIGURATION
# ----------------------------------------------------------------------------
# CORS izinleri (production'da spesifik domain'ler kullanın)
ENABLE_CORS=true
ALLOWED_ORIGINS=*
# Production örneği: ALLOWED_ORIGINS=https://example.com,https://app.example.com

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
# Rate limiting (production'da true yapın!)
ENABLE_RATE_LIMITING=false
# Production'da: ENABLE_RATE_LIMITING=true

# ----------------------------------------------------------------------------
# CACHE CONFIGURATION
# ----------------------------------------------------------------------------
CACHE_TYPE=redis
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_DEFAULT_TIMEOUT=300

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Seçenekler: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FILE=app.log

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------
API_VERSION=1.0.0

# HTTP client ayarları
MAX_CONNECTIONS=10
CONNECTION_TIMEOUT=30

# Thread Pool Configuration (CRITICAL: Prevents "can't start new thread" errors)
MAX_CONCURRENT_REQUESTS=20
MAX_WORKERS_PER_REQUEST=8

# ----------------------------------------------------------------------------
# SENTRY CONFIGURATION
# ----------------------------------------------------------------------------
# Sentry DSN - Hata takibi için (opsiyonel, boş bırakılabilir)
SENTRY_DSN=your-sentry-dsn-here

# Sentry ortam bilgisi
SENTRY_ENVIRONMENT=development
# Seçenekler: development, staging, production

# Sentry trace sampling (0.0 - 1.0, performance tracking için)
SENTRY_TRACES_SAMPLE_RATE=1.0
# Production'da 0.1 gibi düşük bir değer kullanın

# ----------------------------------------------------------------------------
# NOWGOAL API CONFIGURATION (LEGACY - backward compatibility)
# ----------------------------------------------------------------------------
# Ana URL - Trailing slash OLMADAN! (Endpoint'ler / ile başlıyor)
# Seçenekler: https://goaloo.com, https://www.goaloo.com, https://nowgoal.com
# SSL sorunu varsa: http://goaloo.com deneyin
NOWGOAL_BASE_URL=https://www.nowgoal.com

# ----------------------------------------------------------------------------
# MULTI-SOURCE DATA CONFIGURATION (FAST FAILOVER)
# ----------------------------------------------------------------------------
# Primary data source (highest priority)
PRIMARY_DATA_SOURCE=https://www.nowgoal.com

# Fallback data sources (comma-separated list, priority order)
FALLBACK_DATA_SOURCES=https://live5.nowgoal26.com,https://www.goaloo.com

# Source health tracking window (last N requests to track)
SOURCE_HEALTH_WINDOW=100

# Error rate threshold (0.0-1.0) - switch to fallback when exceeded
SOURCE_HEALTH_THRESHOLD=0.3

# Consecutive failures before switching source
CONSECUTIVE_FAIL_THRESHOLD=10

# Minimum seconds between source swaps (prevents thrashing)
MIN_SWAP_INTERVAL=300

# ----------------------------------------------------------------------------
# FAST FAILOVER CONFIGURATION
# ----------------------------------------------------------------------------
# Retry configuration (0 = no retry, immediate failover to goaloo)
MAX_RETRIES_PER_SOURCE=0
RETRY_BACKOFF_FACTOR=0.3

# HTTP timeout configuration (short timeouts for fast failover)
HTTP_TIMEOUT_TOTAL=10
HTTP_TIMEOUT_CONNECT=3
HTTP_TIMEOUT_READ=5

# With these settings:
# - nowgoal26 fails in 5s → immediately try goaloo
# - Total request time: 10-15s (instead of 60-120s)
# - Thread exhaustion prevented by global pool

# ----------------------------------------------------------------------------
# LEAGUE DATA CONFIGURATION
# ----------------------------------------------------------------------------
# League data source (uses different subdomain)
LEAGUE_DATA_SOURCE=https://football.nowgoal26.com

# League cache TTLs (seconds)
LEAGUE_CACHE_TTL_STANDINGS=1800
LEAGUE_CACHE_TTL_MATCHES=3600
LEAGUE_CACHE_TTL_ODDS=300

# League endpoints:
# - /api/v1/leagues/{league_id}/info - Get league info & sub-leagues
# - /api/v1/leagues/{league_id}/standings?season=2025-2026&type=overall
# - /api/v1/leagues/{league_id}/matches?season=2025-2026&round=17
# - /api/v1/leagues/{league_id}/odds?season=2025-2026&round=17
# - /api/v1/leagues/{league_id}/full?season=2025-2026
