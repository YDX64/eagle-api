# =============================================================================
# Systemd Service File for Gol Sinyali API
# =============================================================================
# Installation (Production Linux Server):
#   1. Copy to: sudo cp golsinyali-api.service /etc/systemd/system/
#   2. Edit paths: sudo nano /etc/systemd/system/golsinyali-api.service
#   3. Reload systemd: sudo systemctl daemon-reload
#   4. Enable service: sudo systemctl enable golsinyali-api
#   5. Start service: sudo systemctl start golsinyali-api
#   6. Check status: sudo systemctl status golsinyali-api
#
# Management:
#   sudo systemctl start golsinyali-api     # Start
#   sudo systemctl stop golsinyali-api      # Stop
#   sudo systemctl restart golsinyali-api   # Restart
#   sudo systemctl status golsinyali-api    # Status
#   sudo journalctl -u golsinyali-api -f    # View logs
# =============================================================================

[Unit]
Description=Gol Sinyali API - Football Match Prediction API
Documentation=https://github.com/yourusername/golsinyali-api
After=network.target redis.service
Wants=redis.service

[Service]
Type=notify
User=www-data
Group=www-data

# Working directory - CHANGE THIS TO YOUR APP PATH
WorkingDirectory=/var/www/golsinyali_api

# Environment file - CHANGE PATH IF NEEDED
EnvironmentFile=/var/www/golsinyali_api/.env

# Virtual environment Python - CHANGE PATH IF NEEDED
ExecStart=/var/www/golsinyali_api/instance/bin/gunicorn \
    --config /var/www/golsinyali_api/gunicorn_config.py \
    app:app

# Reload command (graceful restart)
ExecReload=/bin/kill -s HUP $MAINPID

# Stop command (graceful shutdown with 30s timeout)
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart policy
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/golsinyali_api/logs /var/www/golsinyali_api

# Resource limits
LimitNOFILE=65535
LimitNPROC=512

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=golsinyali-api

[Install]
WantedBy=multi-user.target
